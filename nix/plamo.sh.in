#!@shell@
set -euo pipefail

@modelProfiles@

usage() {
    printf '%s\n' \
        'usage: plamo [--model 0.8b|2b|8b|31b] [OPTIONS] [-g|-j|-e] TEXT' \
        '  TEXT       print token IDs' \
        '  -g TEXT    generate from a raw prompt' \
        '  -j TEXT    translate English to Japanese' \
        '  -e TEXT    translate Japanese to English' \
        '  --model    checkpoint size (default: PLAMO_MODEL or 8b)' \
        '  --backend  auto|cpu|metal|metal-fp32 (default: auto; FP32 arithmetic)' \
        '  --memory   auto|resident|stream (default: auto)' \
        '  --threads  auto|1..64 (CPU only)' \
        '  --max-tokens 1..4096 (default: 256)' \
        '' \
        'First download the original model files:' \
        '  nix run github:SuzumiyaAoba/plamo-3-translate.c#download-model -- --model 2b --weights' \
        '' \
        "Data root: \$PLAMO_DATA_DIR or \${XDG_DATA_HOME:-\$HOME/.local/share}/plamo-3-translate-SIZE" \
        'Built with PLaMo. Model files have their own PLaMo Community License.'
}

model=${PLAMO_MODEL:-8b}
while (($#)); do
    case "$1" in
        --model)
            if (($# < 2)); then
                usage >&2
                exit 2
            fi
            model=$2
            shift 2
            ;;
        --model=*)
            model=${1#--model=}
            shift
            ;;
        --)
            shift
            break
            ;;
        *) break ;;
    esac
done
select_model

if (($# == 0)) || [[ ${1:-} == --help || ${1:-} == -h ]]; then
    usage
    exit 0
fi
arguments=("$@")
generation=0
texts=0
invalid() {
    usage >&2
    exit 2
}
while (($#)); do
    case "$1" in
        --help | -h)
            usage
            exit 0
            ;;
        --backend | --memory | --threads | --max-tokens)
            (($# >= 2)) || invalid
            case "$1:$2" in
                --backend:auto | --backend:cpu | --backend:metal | --backend:metal-fp32 | --memory:auto | --memory:resident | --memory:stream | --threads:auto) ;;
                --threads:*)
                    if [[ ! $2 =~ ^[1-9][0-9]?$ ]] || (($2 > 64)); then invalid; fi
                    ;;
                --max-tokens:*)
                    if [[ ! $2 =~ ^[1-9][0-9]{0,3}$ ]] || (($2 > 4096)); then invalid; fi
                    ;;
                *) invalid ;;
            esac
            shift 2
            ;;
        -g | -j | -e)
            (($# >= 2 && !generation && !texts)) || invalid
            generation=1
            texts=1
            shift 2
            ;;
        --)
            (($# == 2 && !texts)) || invalid
            texts=1
            shift 2
            ;;
        -?*) invalid ;;
        *)
            ((!texts)) || invalid
            texts=1
            shift
            ;;
    esac
done
((texts == 1)) || invalid

data_dir=${PLAMO_DATA_DIR:-${XDG_DATA_HOME:-${HOME:?Set HOME or PLAMO_DATA_DIR}/.local/share}/$model_name}
model_dir=$data_dir/$relative_directory
if [[ ! -r $model_dir/tokenizer.jsonl ]]; then
    printf 'plamo: model files are missing from %s\nRun plamo-download --weights --model %s (or the download-model Nix app).\n' "$model_dir" "$model" >&2
    exit 1
fi
if [[ -f $model_dir/REVISION ]] && [[ $(<"$model_dir/REVISION") != "$revision" ]]; then
    printf 'plamo: model revision does not match this implementation: %s\n' "$model_dir" >&2
    exit 1
fi
if ((generation)); then
    for shard in "${weight_files[@]}"; do
        if [[ ! -r $model_dir/$shard ]]; then
            printf 'plamo: weight files are missing. Run plamo-download --weights --model %s.\n' "$model" >&2
            exit 1
        fi
    done
fi

cd -- "$data_dir"
exec "@engines@/plamo-$model" "${arguments[@]}"
